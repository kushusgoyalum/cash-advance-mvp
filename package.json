{
  "name": "cash-advance-service",
  "version": "0.1.0",
  "description": "Cash Advance Service - modular monolith (Fastify + TypeScript + Prisma). API process + worker process from one codebase.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "pnpm prisma:generate",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc && tsc-alias -p tsconfig.json -f -fe .js",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm type-check && pnpm test",
    "prisma:generate": "prisma generate --schema prisma/mysql.prisma && prisma generate --schema prisma/mongodb.prisma",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1083.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.4.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prisma": "^6.19.3",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
